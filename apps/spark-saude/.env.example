# ---------------------------------------------------------------------------
# Spark Saúde — Dashboard da Corretora — example environment
# Copy to .env.local and fill in. NEVER commit .env.local (it holds live secrets).
# ---------------------------------------------------------------------------

# --- GHL API (CLAUDE.md §2) ------------------------------------------------
# API v2 base + version header. Do not change unless GHL changes them.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# The location this dashboard serves (configurable, never hardcoded in code).
GHL_LOCATION_ID=

# Auth — two supported modes, resolved in lib/ghl/auth.ts:
#   (A) Private Integration Token (PIT): a long-lived "pit-..." bearer token.
#       Put it in GHL_ACCESS_TOKEN and leave the OAuth vars blank. No refresh needed.
#   (B) OAuth 2.0 Marketplace app: access + refresh tokens (auto-refreshed server-side).
GHL_ACCESS_TOKEN=
GHL_REFRESH_TOKEN=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# How the "WhatsApp" dispatch actually delivers. The pilot uses an UNOFFICIAL
# WhatsApp integration that rides the GHL SMS channel (free text, no 24h
# template rule), so leave this as SMS. A tenant on the official WhatsApp
# Business API sets it to "WhatsApp".
GHL_WHATSAPP_TRANSPORT=SMS

# --- Supabase (token + tenant-config store, server-side only) --------------
# Service role key is SECRET — server-only, never exposed to the browser.
# Tables live in the isolated `spark_saude` schema and are reached through
# SECURITY DEFINER RPCs in `public`; the schema itself is not PostgREST-exposed.
SUPABASE_URL=https://tbziahcpkrfiksqhuhpe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cotação Leão · CMS Marketplace API (docs/cotacao.md §3) ---------------
# Request the key at developer.cms.gov/marketplace-api/key-request.
# IMPORTANT: the key EXPIRES EVERY 60 DAYS and a new one arrives by email —
# rotating it is just updating this value (no code change / redeploy of code).
# While it is empty, the quote flow serves fixture plans so the UI still works.
CMS_MARKETPLACE_API_KEY=
CMS_API_BASE=https://marketplace.api.healthcare.gov/api/v1

# --- Cotação Leão · proposal links -----------------------------------------
# Public base URL of this app (used to build the /proposta/<token> share links).
# Plan prints are stored in a PRIVATE Supabase Storage bucket named
# `cotacao-prints` (create it in the Supabase dashboard, private, before go-live);
# without Supabase configured, uploads fall back to inline data URLs (dev only).
NEXT_PUBLIC_APP_URL=
# HMAC secret that signs the public proposal tokens. Use a long random string.
PROPOSAL_TOKEN_SECRET=

# --- Development -----------------------------------------------------------
# true  -> serve realistic fixtures (no API calls), for building layout.
# false -> hit the real GHL API. Final path is the real API.
# NOTE: quotes also fall back to fixtures whenever CMS_MARKETPLACE_API_KEY is empty.
GHL_USE_FIXTURES=false

# --- Embedding (iframe inside GHL) -----------------------------------------
# Space-separated CSP frame-ancestors allow-list. Override for white-label domains.
# Default (in code): 'self' https://*.gohighlevel.com https://*.leadconnectorhq.com https://*.msgsndr.com
ALLOWED_FRAME_ANCESTORS=

# --- Cotação Leão · leitura dos prints (lib/cotacao/extract.ts) -------------
# Lê o print do plano (HealthCare.gov) e preenche os campos da opção.
# Sem ela, "Adicionar pelo print" fica indisponível e a corretora digita à mão.
ANTHROPIC_API_KEY=
# Modelos (opcional). Ler campos de um print é transcrição, não raciocínio:
# Haiku 4.5 é o mais barato com visão (US$1/US$5 por milhão de tokens).
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
ANTHROPIC_RECOMMEND_MODEL=claude-sonnet-5
