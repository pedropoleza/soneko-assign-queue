# Spark QR — painel admin (app separado)

# URL pública da Edge Function admin (sem barra no final)
VITE_SPARK_QR_API=https://tbziahcpkrfiksqhuhpe.supabase.co/functions/v1/spark-qr-admin

# Base pública que os QRs codificam. Depois que o DNS do subdomínio propagar,
# troque para https://qr.sparkleads.com. Enquanto isso, cai na própria Edge
# Function de redirect (os QRs já funcionam ponta a ponta).
VITE_QR_PUBLIC_BASE=https://qr.sparkleads.com

# O painel abre sem login (a function admin se autoriza sozinha). Se um dia
# você reativar a checagem de secret na function, dá pra embutir o secret no
# build aqui. Pegue o valor com: select public.spark_qr_config();
# VITE_SPARK_QR_DEFAULT_SECRET=
