# Build de produção (Vercel). A base que os QRs codificam aponta para o próprio
# domínio da Vercel — assim o cliente NUNCA vê a URL do Supabase ao ler o QR.
# A Vercel faz o proxy/redirect por trás (ver vercel.json).
# Quando o DNS de qr.sparkleads.com estiver pronto, troque para
# https://qr.sparkleads.com e refaça o deploy.
VITE_QR_PUBLIC_BASE=https://spark-qr-eight.vercel.app
