# ─── Frontend (bundle público — NUNCA colocar segredos aqui) ────────────────
# URL pública da Edge Function spark-api (sem barra no final)
VITE_SPARK_API_URL=https://<project-ref>.supabase.co/functions/v1/spark-api
# Supabase anon key (opcional — Realtime; sem ela cai pra polling)
# VITE_SUPABASE_ANON_KEY=

# ─── Edge Functions / servidor (configurar como secrets do Supabase) ────────
# Supabase — SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente nas Edge Functions; não precisa setar manualmente.
STORAGE_BUCKET_NAME=spark-audio

# Sessão do painel (HMAC) — gere com: openssl rand -hex 32
SPARK_SESSION_SECRET=

# ElevenLabs (D7 = 1 chave central no MVP — vive só no servidor)
ELEVENLABS_API_KEY=

# GoHighLevel (D1 = App GHL com OAuth)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/spark-oauth/callback
GHL_WEBHOOK_SECRET=

# Limites default de plano (D3)
DEFAULT_MONTHLY_AUDIO_LIMIT=100
DEFAULT_MONTHLY_CHARACTER_LIMIT=20000

# URL pública do app (para montar links no painel/GHL)
APP_URL=https://<seu-dominio>
