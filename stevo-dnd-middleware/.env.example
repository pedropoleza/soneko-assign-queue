# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Segurança do webhook (GHL -> middleware) ────────────────────────────────
# Mesmo valor configurado no header x-webhook-secret do Custom Webhook no GHL.
WEBHOOK_SECRET=troque_este_valor

# ── Cliente 1 ───────────────────────────────────────────────────────────────
# locationId do GHL (Settings -> Business Profile -> Location ID)
GHL_CLIENT_1_LOCATION_ID=LOCATION_ID_CLIENTE_1
GHL_CLIENT_1_NAME=Cliente 1

# Instância principal (obrigatória).
# serverUrl e API Key são exibidos no painel da instância no StevoManager V2.
# O servidor tem formato https://smv2-N.stevo.chat (ex.: https://smv2-1.stevo.chat).
STEVO_CLIENT_1_MAIN_SERVER_URL=https://smv2-1.stevo.chat
STEVO_CLIENT_1_MAIN_API_KEY=sua_api_key

# Instância secundária (opcional — deixe em branco/remova se o cliente tiver só um número)
STEVO_CLIENT_1_SECONDARY_SERVER_URL=https://smv2-2.stevo.chat
STEVO_CLIENT_1_SECONDARY_API_KEY=sua_api_key_2

# ── Ajustes finos da API do Stevo (defaults já validados; só mude se a API mudar) ──
# STEVO_API_KEY_HEADER=apikey
# STEVO_BLOCK_PATH=/user/block
# STEVO_UNBLOCK_PATH=/user/unblock
# STEVO_BLOCKLIST_PATH=/user/blocklist
# STEVO_PHONE_FIELD=number
# STEVO_TIMEOUT_MS=15000
